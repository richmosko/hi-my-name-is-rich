---
import MainLayout from '../layouts/MainLayout.astro';
import ConstellationGraph from '../components/ConstellationGraph';
---

<MainLayout title="Constellation" noFooter fullScreen>
  <div class="relative w-full overflow-hidden" style="height: calc(100dvh - 65px)">
    <ConstellationGraph
      client:load
      autoFit
      interactive
      showWikilinks={true}
      showTags={true}
    />
  </div>
</MainLayout>
