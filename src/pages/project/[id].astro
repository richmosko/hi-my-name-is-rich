---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { authors } from '../../data/authors';
import { parseLocalDate } from '../../lib/dateUtils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Resolve authors
const authorIds = Array.isArray(project.data.authorId) ? project.data.authorId : project.data.authorId ? [project.data.authorId] : ['rich'];
const projectAuthors = authorIds.map(id => authors[id]).filter(Boolean);

const heroImage = project.data.image || project.data.imageUpload || undefined;
const aspectRatio = project.data.imageAspectRatio || '16/9';

// Compute completion from MDX tasks (Vikunja will enhance this client-side)
const tasks = project.data.tasks || [];
const completedTasks = tasks.filter(t => t.completed).length;
const percent = tasks.length > 0 ? Math.round((completedTasks / tasks.length) * 100) : 0;
---

<MainLayout
  title={project.data.name}
  description={project.data.description}
  image={heroImage}
>
  <div class="flex flex-col gap-6 items-center">
    <div class="w-full max-w-[640px]">
      <!-- Back link -->
      <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-content-muted hover:text-accent mb-6 transition-colors">
        <span>‹</span> Back to projects
      </a>

      <!-- Author + dates -->
      <div class="flex items-center gap-3 mb-4">
        <div class="flex -space-x-2">
          {projectAuthors.map(author => (
            <img src={author.avatar} alt={author.name} class="w-10 h-10 rounded-full border-2 border-surface" />
          ))}
        </div>
        <div>
          <div class="text-sm font-medium text-content">
            {projectAuthors.map(a => a.name).join(' & ')}
          </div>
          {project.data.startDate && (
            <time class="text-xs text-content-muted">
              Started {parseLocalDate(project.data.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          )}
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-content mb-2">
        {project.data.name}
      </h1>
      <p class="text-content-secondary mb-4">{project.data.description}</p>

      <!-- Status + progress -->
      <div class="flex items-center gap-3 mb-4">
        <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${
          project.data.status === 'completed' ? 'bg-emerald-500/10 text-emerald-700' : 'bg-accent/10 text-accent'
        }`}>
          {project.data.status === 'completed' ? 'Completed' : 'Active'}
        </span>
        <span class="text-sm font-semibold text-accent">{percent}%</span>
      </div>

      <!-- Progress bar -->
      <div class="w-full h-2 rounded-full bg-surface-secondary overflow-hidden mb-6">
        <div
          class={`h-full rounded-full transition-all duration-500 ${percent === 100 ? 'bg-emerald-500' : 'bg-accent'}`}
          style={`width: ${percent}%`}
        />
      </div>

      {project.data.url && project.data.url !== '#' && (
        <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:text-accent-hover mb-4 inline-block">
          Visit Project →
        </a>
      )}
    </div>

    <!-- Hero image (wider) -->
    {heroImage && heroImage !== '' && (
      <div class="w-full max-w-[1250px]">
        <img
          src={heroImage}
          alt={project.data.name}
          class="w-full rounded-2xl object-cover"
          style={`aspect-ratio: ${aspectRatio}`}
        />
      </div>
    )}

    <!-- MDX Content -->
    <article class="w-full max-w-[640px] prose-custom">
      <Content />
    </article>

    <!-- Static task list (MDX-based, Vikunja enhancement is a React island for later) -->
    {tasks.length > 0 && (
      <div class="w-full max-w-[640px]">
        <h2 class="text-lg font-semibold text-content mb-3">
          Tasks · {completedTasks}/{tasks.length}
        </h2>
        <ul class="space-y-1.5">
          {tasks.map(task => (
            <li class="flex items-center gap-2.5">
              <span class={`shrink-0 w-4 h-4 rounded flex items-center justify-center border ${
                task.completed ? 'bg-accent border-accent text-white' : 'border-edge bg-surface'
              }`}>
                {task.completed && (
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </span>
              <span class={`text-sm ${task.completed ? 'text-content-muted line-through' : 'text-content'}`}>
                {task.title}
              </span>
              {task.group && (
                <span class="text-[10px] text-content-muted">{task.group}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</MainLayout>
