---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Convert to the BlogPost format that PostCard expects
const blogPosts = sortedPosts.map(p => ({
  id: p.id,
  slug: p.id,
  title: p.data.title,
  excerpt: p.data.excerpt,
  date: p.data.date,
  readTime: p.data.readTime || '1 min read',
  categories: p.data.categories as string[],
  featured: p.data.featured,
  image: p.data.image || p.data.imageUpload || undefined,
  imageAspectRatio: p.data.imageAspectRatio,
  authorId: p.data.authorId,
  tags: p.data.tags || [],
}));
---

<MainLayout title="All Posts">
  <div class="flex flex-col gap-8 items-center">
    <div class="w-full max-w-[640px]">
      <h1 class="text-2xl sm:text-3xl font-bold text-content">All Posts</h1>
      <p class="text-content-secondary mt-2 text-sm">{sortedPosts.length} posts</p>
    </div>

    <!-- Hero image -->
    <div class="w-full max-w-[1250px] rounded-2xl overflow-hidden">
      <img
        src="/images/stock/profile-rich-writing.jpg"
        alt="Writing"
        class="w-full h-auto object-cover aspect-[21/9]"
      />
    </div>

    <!-- Post list -->
    <div class="w-full max-w-[640px] flex flex-col gap-6">
      {blogPosts.map(post => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</MainLayout>
