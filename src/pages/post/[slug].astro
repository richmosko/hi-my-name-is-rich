---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { parseLocalDate } from '../../lib/dateUtils';
import { authors } from '../../data/authors';
import { categoryConfig } from '../../data/categories';
import LightboxImage from '../../components/LightboxImage';
import Comments from '../../components/Comments';
import { mdxComponents } from '../../components/MdxComponents';
import { categoryColors } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get all posts sorted for prev/next navigation
const allPosts = (await getCollection('posts')).sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);
const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Resolve authors
const authorIds = Array.isArray(post.data.authorId) ? post.data.authorId : [post.data.authorId];
const postAuthors = authorIds.map(id => authors[id]).filter(Boolean);

// Resolve image (fallback to imageUpload)
const heroImage = post.data.image || post.data.imageUpload || undefined;
const aspectRatio = post.data.imageAspectRatio || '16/9';

// Resolve categories
const categories = Array.isArray(post.data.categories) ? post.data.categories : [post.data.categories];

const formattedDate = parseLocalDate(post.data.date).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<MainLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={heroImage}
>
  <article class="flex flex-col gap-8 items-center">
    <!-- Header — at text width -->
    <header class="w-full max-w-[640px] flex flex-col gap-6">
      <!-- Back link -->
      <a href="/posts" class="text-sm text-content-muted hover:text-accent transition-colors inline-flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to posts
      </a>

      <!-- Author + date (inline row) -->
      <div class="flex items-center gap-4">
        {postAuthors.length > 0 && (
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              {postAuthors.map(author => (
                <img
                  src={author.avatar}
                  alt={author.name}
                  class="w-[48px] h-[48px] rounded-full object-cover border-2 border-surface"
                />
              ))}
            </div>
            <span class="text-base font-medium text-content">
              {postAuthors.map(a => a.name).join(' & ')}
            </span>
          </div>
        )}
        <time datetime={post.data.date} class="text-sm font-medium text-content-muted">
          {formattedDate}
        </time>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-content">
        {post.data.title}
      </h1>

      <!-- Read time + categories + tags (grey background bar) -->
      <div class="flex items-center justify-between bg-surface-secondary rounded-xl px-3 py-2.5">
        <span class="text-sm font-medium text-content-muted">
          {post.data.readTime}
        </span>
        <div class="flex flex-wrap gap-2">
          {categories.map(cat => {
            const config = categoryConfig[cat as keyof typeof categoryConfig];
            return config ? (
              <a href={`/${cat}`} class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${categoryColors[cat as keyof typeof categoryColors] ?? 'bg-surface-secondary text-content-muted'}`}>
                {config.label}
              </a>
            ) : (
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-secondary text-content-muted">{cat}</span>
            );
          })}
          {(post.data.tags || []).map(tag => (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-secondary text-content-muted">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Content area: hero + MDX + nav — wider gaps -->
    <div class="w-full flex flex-col gap-10 items-center">
      <!-- Hero image (wider) -->
      {heroImage && (
        <div class="w-full max-w-[1250px]">
          <img
            src={heroImage}
            alt={post.data.title}
            class="w-full rounded-2xl object-cover"
            style={`aspect-ratio: ${aspectRatio}`}
          />
        </div>
      )}

      <!-- MDX Content -->
      <div class="w-full max-w-[640px] flex flex-col gap-4 text-content-secondary leading-relaxed">
      <Content components={{
        ...mdxComponents,
        img: LightboxImage,
      }} />
      </div>

      <!-- Prev/Next navigation -->
      <nav class="w-full max-w-[640px] flex justify-between items-center border-t border-edge pt-6 mt-4">
        {prevPost ? (
          <a href={`/post/${prevPost.id}`} class="text-sm text-content-muted hover:text-accent transition-colors">
            ← Previous Post
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`/post/${nextPost.id}`} class="text-sm text-content-muted hover:text-accent transition-colors">
            Next Post →
          </a>
        ) : <span />}
      </nav>

      <!-- Comments -->
      <div class="w-full max-w-[640px]">
        <Comments client:visible pageId={post.id} />
      </div>
    </div>
</MainLayout>
