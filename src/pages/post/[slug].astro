---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { parseLocalDate } from '../../lib/dateUtils';
import { authors } from '../../data/authors';
import { categoryConfig } from '../../data/categories';
import LightboxImage from '../../components/LightboxImage';
import Gallery from '../../components/Gallery';
import Video from '../../components/Video';
import YouTube from '../../components/YouTube';
import Comments from '../../components/Comments';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get all posts sorted for prev/next navigation
const allPosts = (await getCollection('posts')).sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);
const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Resolve authors
const authorIds = Array.isArray(post.data.authorId) ? post.data.authorId : [post.data.authorId];
const postAuthors = authorIds.map(id => authors[id]).filter(Boolean);

// Resolve image (fallback to imageUpload)
const heroImage = post.data.image || post.data.imageUpload || undefined;
const aspectRatio = post.data.imageAspectRatio || '16/9';

// Resolve categories
const categories = Array.isArray(post.data.categories) ? post.data.categories : [post.data.categories];

const formattedDate = parseLocalDate(post.data.date).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<MainLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={heroImage}
>
  <div class="flex flex-col gap-6 items-center">
    <article class="w-full max-w-[640px]">
      <!-- Back link -->
      <a href="/posts" class="inline-flex items-center gap-1.5 text-sm text-content-muted hover:text-accent mb-6 transition-colors">
        <span>‹</span> Back to posts
      </a>

      <!-- Author + date -->
      <div class="flex items-center gap-3 mb-4">
        <div class="flex -space-x-2">
          {postAuthors.map(author => (
            <img
              src={author.avatar}
              alt={author.name}
              class="w-10 h-10 rounded-full border-2 border-surface"
            />
          ))}
        </div>
        <div>
          <div class="text-sm font-medium text-content">
            {postAuthors.map(a => a.name).join(' & ')}
          </div>
          <time class="text-xs text-content-muted">{formattedDate}</time>
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-content mb-4">
        {post.data.title}
      </h1>

      <!-- Read time + categories + tags -->
      <div class="flex flex-wrap items-center gap-2 mb-6 text-sm">
        <span class="text-content-muted">{post.data.readTime}</span>
        {categories.map(cat => {
          const config = categoryConfig[cat as keyof typeof categoryConfig];
          return config ? (
            <a href={`/${cat}`} class={`px-2.5 py-0.5 rounded-full text-xs font-medium ${config.badgeColors}`}>
              {config.label}
            </a>
          ) : (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{cat}</span>
          );
        })}
        {(post.data.tags || []).map(tag => (
          <a href={`/posts?tag=${encodeURIComponent(tag)}`} class="text-xs text-content-muted hover:text-accent">
            {tag}
          </a>
        ))}
      </div>
    </article>

    <!-- Hero image (wider) -->
    {heroImage && (
      <div class="w-full max-w-[1250px]">
        <img
          src={heroImage}
          alt={post.data.title}
          class="w-full rounded-2xl object-cover"
          style={`aspect-ratio: ${aspectRatio}`}
        />
      </div>
    )}

    <!-- MDX Content -->
    <article class="w-full max-w-[640px] prose-custom">
      <Content components={{
        img: LightboxImage,
        Gallery,
        Video,
        YouTube,
      }} />
    </article>

    <!-- Prev/Next navigation -->
    <nav class="w-full max-w-[640px] flex justify-between items-center pt-6 border-t border-edge">
      {prevPost ? (
        <a href={`/post/${prevPost.id}`} class="text-sm text-content-muted hover:text-accent transition-colors">
          ← Previous Post
        </a>
      ) : <span />}
      {nextPost ? (
        <a href={`/post/${nextPost.id}`} class="text-sm text-content-muted hover:text-accent transition-colors">
          Next Post →
        </a>
      ) : <span />}
    </nav>

    <!-- Comments -->
    <div class="w-full max-w-[640px]">
      <Comments client:visible pageId={post.id} />
    </div>
  </div>
</MainLayout>
