---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { parseLocalDate } from '../lib/dateUtils';
import { authors } from '../data/authors';
import { categoryConfig } from '../data/categories';
import PostCard from '../components/PostCard';
import ConstellationGraph from '../components/ConstellationGraph';
import siteSettings from '../data/site-settings.json';

const posts = await getCollection('posts');

// Sort posts newest first (with slug as tiebreaker)
const sortedPosts = posts.sort((a, b) => {
  const diff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  return diff !== 0 ? diff : a.id.localeCompare(b.id);
});

// Featured: latest post + up to 2 non-duplicate featured posts
const latestPost = sortedPosts[0];
const featuredOthers = sortedPosts
  .filter((p) => p.data.featured && p.id !== latestPost?.id)
  .slice(0, 2);

const rich = authors['rich'];

// Convert to BlogPost format for PostCard
function toBlogPost(p: typeof sortedPosts[0]) {
  return {
    id: p.id,
    slug: p.id,
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.date,
    readTime: p.data.readTime || '1 min read',
    categories: p.data.categories as string[],
    featured: p.data.featured,
    image: p.data.image || p.data.imageUpload || undefined,
    imageAspectRatio: p.data.imageAspectRatio,
    authorId: p.data.authorId,
    tags: p.data.tags || [],
  };
}
---

<MainLayout>
  <div class="flex flex-col gap-10 items-center">
    <!-- Profile + Intro -->
    <div class="flex flex-col items-center gap-6 max-w-[640px] w-full">
      <img
        src={siteSettings.profileImage}
        alt={rich?.name || 'Profile'}
        class="w-[40vw] max-w-[414px] rounded-3xl"
      />

      <div>
        <h1 class="text-4xl sm:text-5xl font-bold text-content mb-4">
          Hi, my name is Rich.
        </h1>
        <p class="text-content-secondary text-lg leading-relaxed">
          Former <strong>Hardware Designer</strong>, part-time
          <strong>Adventurer</strong>, and full-time <strong>Loafer</strong> and
          <strong>Fudgel</strong>. This is a place for me to share what I'm learning,
          building, and thinking about.
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-6 w-full">
        <a href="/about" class="text-accent hover:text-accent-hover text-sm font-medium transition-colors">
          More about me →
        </a>
        <a href="/posts" class="text-accent hover:text-accent-hover text-sm font-medium transition-colors">
          Latest posts →
        </a>
      </div>
    </div>

    <!-- Featured Posts -->
    <div class="w-full max-w-[1250px]">
      <h2 class="text-2xl font-semibold text-content mb-6 text-center">Featured Posts</h2>

      <div class="flex flex-col lg:flex-row gap-6">
        {/* Large card — latest post */}
        {latestPost && (
          <div class="lg:w-2/3">
            <PostCard post={toBlogPost(latestPost)} variant="large" />
          </div>
        )}

        {/* Stacked compact cards */}
        {featuredOthers.length > 0 && (
          <div class="lg:w-1/3 flex flex-col gap-6">
            {featuredOthers.map((post) => (
              <PostCard post={toBlogPost(post)} variant="compact" />
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Constellation Graph Preview -->
    <div class="w-full max-w-[1250px]">
      <div class="flex items-center gap-3 mb-4 justify-center">
        <a href="/constellation" class="text-2xl font-semibold text-content hover:text-accent transition-colors">
          Constellation Graph
        </a>
      </div>
      <div class="rounded-xl overflow-hidden" style="height: min(500px, 50vh)">
        <ConstellationGraph
          client:visible
          autoFit
          interactive={false}
          showWikilinks={true}
          showTags={true}
          style={{ width: '100%', height: '100%' }}
        />
      </div>
    </div>
  </div>
</MainLayout>
