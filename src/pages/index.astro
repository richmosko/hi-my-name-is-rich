---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const projects = await getCollection('projects');

// Sort posts newest first
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featuredPosts = sortedPosts.filter((p) => p.data.featured).slice(0, 3);
const latestPosts = sortedPosts.slice(0, 5);
---

<Layout title="Home">
  <main class="max-w-[1440px] mx-auto px-5 sm:px-10 lg:px-[95px] py-8">
    <h1 class="text-4xl font-bold text-content mb-4">Hi, my name is Rich.</h1>
    <p class="text-content-secondary mb-8">
      This site is powered by Astro 6. Content collections loaded successfully.
    </p>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="rounded-xl border border-edge p-4">
        <div class="text-2xl font-bold text-accent">{posts.length}</div>
        <div class="text-sm text-content-muted">Posts</div>
      </div>
      <div class="rounded-xl border border-edge p-4">
        <div class="text-2xl font-bold text-accent">{projects.length}</div>
        <div class="text-sm text-content-muted">Projects</div>
      </div>
      <div class="rounded-xl border border-edge p-4">
        <div class="text-2xl font-bold text-accent">{featuredPosts.length}</div>
        <div class="text-sm text-content-muted">Featured</div>
      </div>
    </div>

    <!-- Featured Posts -->
    <h2 class="text-2xl font-semibold text-content mb-4">Featured Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      {featuredPosts.map((post) => (
        <a href={`/post/${post.id}`} class="rounded-xl border border-edge p-4 hover:border-accent transition-colors">
          <h3 class="font-semibold text-content">{post.data.title}</h3>
          <p class="text-sm text-content-muted mt-1">{post.data.excerpt}</p>
          <div class="text-xs text-content-muted mt-2">{post.data.date}</div>
        </a>
      ))}
    </div>

    <!-- Latest Posts -->
    <h2 class="text-2xl font-semibold text-content mb-4">Latest Posts</h2>
    <ul class="space-y-3 mb-8">
      {latestPosts.map((post) => (
        <li>
          <a href={`/post/${post.id}`} class="flex justify-between items-baseline hover:text-accent transition-colors">
            <span class="text-content font-medium">{post.data.title}</span>
            <span class="text-sm text-content-muted">{post.data.date}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Projects -->
    <h2 class="text-2xl font-semibold text-content mb-4">Projects</h2>
    <ul class="space-y-3">
      {projects.map((project) => (
        <li>
          <a href={`/project/${project.id}`} class="flex justify-between items-baseline hover:text-accent transition-colors">
            <span class="text-content font-medium">{project.data.name}</span>
            <span class="text-sm text-content-muted">{project.data.status}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
