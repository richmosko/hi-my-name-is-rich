---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { parseLocalDate } from '../lib/dateUtils';
import { authors } from '../data/authors';
import { categoryConfig } from '../data/categories';
import PostCard from '../components/PostCard';
import ConstellationGraph from '../components/ConstellationGraph';
import siteSettings from '../data/site-settings.json';

const posts = await getCollection('posts');

// Sort posts newest first (with slug as tiebreaker)
const sortedPosts = posts.sort((a, b) => {
  const diff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  return diff !== 0 ? diff : a.id.localeCompare(b.id);
});

// Featured: latest post + up to 2 non-duplicate featured posts
const latestPost = sortedPosts[0];
const featuredOthers = sortedPosts
  .filter((p) => p.data.featured && p.id !== latestPost?.id)
  .slice(0, 2);

const rich = authors['rich'];

// Convert to BlogPost format for PostCard
function toBlogPost(p: typeof sortedPosts[0]) {
  return {
    id: p.id,
    slug: p.id,
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.date,
    readTime: p.data.readTime || '1 min read',
    categories: p.data.categories as string[],
    featured: p.data.featured,
    image: p.data.image || p.data.imageUpload || undefined,
    imageAspectRatio: p.data.imageAspectRatio,
    authorId: p.data.authorId,
    tags: p.data.tags || [],
  };
}
---

<MainLayout>
  <div class="flex flex-col gap-10 sm:gap-16">
    <!-- Hero section -->
    <section class="flex flex-col-reverse lg:flex-row items-center lg:items-start gap-8 lg:gap-10">
      <!-- Text — left side on desktop, below image on mobile -->
      <div class="flex-1 flex flex-col gap-4 sm:gap-6">
        <h1 class="text-3xl sm:text-4xl font-bold text-content leading-tight">
          Hi, my name is Rich.
        </h1>
        <p class="text-base sm:text-xl font-light text-content-secondary leading-relaxed">
          Former <span class="text-lg sm:text-2xl font-normal">Hardware Designer</span>,
          part-time <span class="text-lg sm:text-2xl font-normal">Adventurer</span>,
          and full-time <span class="text-lg sm:text-2xl font-normal">Loafer</span> and
          <span class="text-lg sm:text-2xl font-normal">Fudgel</span>. This is a place
          for me to share what I'm learning, building, and thinking about.
        </p>
        <p class="text-base sm:text-xl font-light text-content-secondary leading-relaxed">
          I am by no means an expert... at pretty much anything. But I am
          naturally <span class="text-lg sm:text-2xl font-normal">curious</span>, and
          find myself with a lot of time to ponder the meaning of
          things. This project is meant to be a
          <span class="text-lg sm:text-2xl font-normal">learning</span> and
          <span class="text-lg sm:text-2xl font-normal">growing</span> experience for
          me. It's pretty much not useful to anyone whatsoever... but if
          you've stumbled here by accident:
          <span class="text-lg sm:text-2xl font-semibold">Welcome Friend!</span>
          Hopefully I'm able to share a bit of positivity and joy.
        </p>
        <div class="pt-2 flex flex-col gap-1">
          <a href="/about" class="text-sm font-medium text-content-muted hover:text-content transition-colors duration-150">
            More about me &rarr;
          </a>
          <a href="/posts" class="text-sm font-medium text-content-muted hover:text-content transition-colors duration-150">
            Latest posts &rarr;
          </a>
        </div>
      </div>

      <!-- Profile image — right side on desktop, top on mobile -->
      <div class="w-[60%] sm:w-[40%] max-w-[414px]">
        <img
          src="/images/profiles/profile-rich.jpeg"
          alt="Rich Mosko"
          class="w-full aspect-square rounded-2xl object-cover shadow-sm"
        />
      </div>
    </section>

    <!-- Featured Posts -->
    <div class="w-full max-w-[1250px]">
      <h2 class="text-2xl font-semibold text-content mb-6 text-center">Featured Posts</h2>

      <div class="flex flex-col lg:flex-row gap-6">
        {/* Large card — latest post */}
        {latestPost && (
          <div class="lg:w-2/3">
            <PostCard post={toBlogPost(latestPost)} variant="large" />
          </div>
        )}

        {/* Stacked compact cards */}
        {featuredOthers.length > 0 && (
          <div class="lg:w-1/3 flex flex-col gap-6">
            {featuredOthers.map((post) => (
              <PostCard post={toBlogPost(post)} variant="compact" />
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Constellation Graph Preview -->
    <div class="w-full max-w-[1250px]">
      <div class="flex items-center gap-3 mb-4 justify-center">
        <a href="/constellation" class="text-2xl font-semibold text-content hover:text-accent transition-colors">
          Constellation Graph
        </a>
      </div>
      <div class="rounded-xl overflow-hidden" style="height: min(500px, 50vh)">
        <ConstellationGraph
          client:visible
          autoFit
          interactive={false}
          showWikilinks={true}
          showTags={true}
          style={{ width: '100%', height: '100%' }}
        />
      </div>
    </div>
  </div>
</MainLayout>
