---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const activeProjects = projects.filter(p => p.data.status === 'active');
const completedProjects = projects.filter(p => p.data.status === 'completed');

function getPercent(project: typeof projects[0]) {
  const tasks = project.data.tasks || [];
  const done = tasks.filter(t => t.completed).length;
  return tasks.length > 0 ? Math.round((done / tasks.length) * 100) : 0;
}
---

<MainLayout title="Projects">
  <div class="flex flex-col gap-8 items-center">
    <div class="w-full max-w-[640px]">
      <h1 class="text-2xl sm:text-3xl font-bold text-content">Projects</h1>
      <p class="text-content-secondary mt-2 text-sm">
        What I'm building, tinkering with, and have shipped.
      </p>
    </div>

    <!-- Hero image -->
    <div class="w-full max-w-[1250px] rounded-2xl overflow-hidden">
      <img
        src="/images/stock/profile-rich-welding.jpg"
        alt="Rich welding in the workshop"
        class="w-full h-auto object-cover aspect-[21/9]"
      />
    </div>

    <!-- Active projects -->
    {activeProjects.length > 0 && (
      <section class="w-full max-w-[640px] flex flex-col gap-6">
        <h2 class="text-xl font-semibold text-content">In Progress</h2>
        {activeProjects.map(project => {
          const percent = getPercent(project);
          return (
            <a href={`/project/${project.id}`} class="rounded-2xl border border-edge p-5 sm:p-8 hover:border-accent transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-lg sm:text-xl font-semibold text-content">{project.data.name}</h3>
                  <p class="text-sm text-content-secondary mt-1">{project.data.description}</p>
                </div>
                <span class="text-xl sm:text-2xl font-bold text-accent shrink-0">{percent}%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-secondary overflow-hidden mt-4">
                <div class="h-full rounded-full bg-accent transition-all duration-500" style={`width: ${percent}%`} />
              </div>
            </a>
          );
        })}
      </section>
    )}

    <!-- Completed projects -->
    {completedProjects.length > 0 && (
      <section class="w-full max-w-[640px] flex flex-col gap-6">
        <h2 class="text-xl font-semibold text-content-muted">Completed</h2>
        {completedProjects.map(project => (
          <a href={`/project/${project.id}`} class="rounded-2xl border border-edge/60 bg-surface-secondary/40 p-5 sm:p-8">
            <h3 class="text-lg font-semibold text-content-muted">{project.data.name}</h3>
            <p class="text-sm text-content-muted mt-1">{project.data.description}</p>
          </a>
        ))}
      </section>
    )}
  </div>
</MainLayout>
